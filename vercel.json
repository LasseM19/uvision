{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|favicon\\.svg|pwa-192\\.png|pwa-512\\.png|manifest\\.webmanifest|reset\\.html|sw\\.js|workbox-.*|registerSW\\.js).*)",
      "destination": "/index.html"
    }
  ]
}
